# =============================================================================
# MCP2AI - configuration template
# =============================================================================
# Copy this file to config.properties (in the same directory) and fill in the
# values for your provider. config.properties is gitignored.
#
# Resolution order for each key:
#   1. Environment variable (highest priority)
#   2. config.properties (this file, once renamed)
#   3. Hard-coded default
#
# Provider-specific ready-to-use templates:
#   config.properties.openai   - OpenAI cloud (https://api.openai.com/v1)
#   config.properties.ollama   - Ollama local server (http://localhost:11434/v1)
#   config.properties.lmstudio - LM Studio local server (http://localhost:1234/v1)
# =============================================================================

# Base URL of the OpenAI-compatible API endpoint
# OpenAI cloud:   https://api.openai.com/v1
# Ollama:         http://localhost:11434/v1
# LM Studio:      http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# API key
# OpenAI cloud:   your real sk-... key
# Local servers:  any non-empty string (authentication is not checked)
OPENAI_API_KEY=

# Model to use for the review LLM call
OPENAI_MODEL=

# Temperature for the review LLM call (0.0-1.0)
# Use 0.01 instead of exactly 0.0 for local Ollama models that handle the zero boundary poorly.
OPENAI_TEMPERATURE=0.01

# Request timeout in seconds (default: 120 = 2 minutes)
# Lower this for interactive use; raise it for slow local models.
OPENAI_TIMEOUT=120

# Fully qualified path to system prompt for review tool (default: hardcoded SystemPrompt.Review.md)
OPENAI_SYSTEMPROMPT_REVIEW=

# Fully qualified path to system prompt for obfuscate tool (default: hardcoded SystemPrompt.Obfuscate.md)
OPENAI_SYSTEMPROMPT_OBFUSCATE=

# Fully qualified path to a template containing optional text in the user's writing style
OPENAI_SYSTEMPROMPT_OBFUSCATE_TEMPLATE=

# IP address or hostname to bin internal HTTP server  (default: 127.0.0.1)
MCP_STREAMABLE_HOST=

# IP address or hostname to bin internal HTTP server  (default: 8081)
MCP_STREAMABLE_PORT=
