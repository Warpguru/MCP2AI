# =============================================================================
# MCP2AI - Ollama local server template
# =============================================================================
# Copy this file to config.properties and adjust model names to match what
# you have pulled locally (run: ollama list).
# =============================================================================

# Ollama url
OPENAI_BASE_URL=http://localhost:11434/v1

# Ollama does not require authentication â any non-empty string works
OPENAI_API_KEY=local

# Ollama model
OPENAI_MODEL=llama3.2:3b

# Ollama temperature for the review LLM call (0.0-1.0)
OPENAI_TEMPERATURE=0.01

# Request timeout in seconds (default: 120 = 2 minutes)
# Increase for large local models that are slow to respond.
OPENAI_TIMEOUT=120

# Fully qualified path to system prompt for review tool (default: hardcoded)
OPENAI_SYSTEMPROMPT_REVIEW=

# Fully qualified path to system prompt for obfuscate tool (default: hardcoded)
OPENAI_SYSTEMPROMPT_OBFUSCATE=

# IP address or hostname to bin internal HTTP server  (default: 127.0.0.1)
MCP_STREAMABLE_HOST=

# IP address or hostname to bin internal HTTP server  (default: )
MCP_STREAMABLE_PORT=
