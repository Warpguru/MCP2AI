# =============================================================================
# MCP2AI - OpenAI cloud template
# =============================================================================
# Copy this file to config.properties and add your API key.
# All models listed here are available on https://api.openai.com/v1.
# See https://platform.openai.com/docs/models for the latest model names.
# =============================================================================

# OpenAI url
OPENAI_BASE_URL=https://api.openai.com/v1

# Replace with your real OpenAI API key (starts with sk-)
OPENAI_API_KEY=sk-...

# OpenAI model
OPENAI_MODEL=gpt-4o-mini

# OpenAI temperature for the review LLM call (OpenAI currently supports only 1)
OPENAI_TEMPERATURE=1.00

# Request timeout in seconds (default: 120 = 2 minutes)
OPENAI_TIMEOUT=120

# Fully qualified path to system prompt for review tool (default: hardcoded)
OPENAI_SYSTEMPROMPT_REVIEW=

# Fully qualified path to system prompt for obfuscate tool (default: hardcoded)
OPENAI_SYSTEMPROMPT_OBFUSCATE=

# IP address or hostname to bin internal HTTP server  (default: 127.0.0.1)
MCP_STREAMABLE_HOST=

# IP address or hostname to bin internal HTTP server  (default: )
MCP_STREAMABLE_PORT=
