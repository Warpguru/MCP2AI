# =============================================================================
# MCP2AI - OpenAI cloud template
# =============================================================================
# Copy this file to config.properties and add your API key.
# All models listed here are available on https://api.openai.com/v1.
# See https://platform.openai.com/docs/models for the latest model names.
# =============================================================================

OPENAI_BASE_URL=https://api.openai.com/v1

# Replace with your real OpenAI API key (starts with sk-)
OPENAI_API_KEY=sk-...

# chat / stream / vision
OPENAI_MODEL=gpt-4o-mini

# embed
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# reason  (o-series reasoning model)
OPENAI_REASONING_MODEL=o4-mini

# tts
OPENAI_TTS_MODEL=tts-1

# stt
OPENAI_STT_MODEL=whisper-1

# imagegen
OPENAI_IMAGE_MODEL=gpt-image-1

# moderate
OPENAI_MODERATION_MODEL=omni-moderation-latest
