# =============================================================================
# MCP2AI - LM Studio local server template
# =============================================================================
# Copy this file to config.properties and set the model name to the one
# currently loaded in LM Studio (shown in the top bar of the app).
# =============================================================================

# LMStudio url
OPENAI_BASE_URL=http://localhost:1234/v1

# LM Studio does not require authentication - any non-empty string works
OPENAI_API_KEY=local

# LMStudio model
OPENAI_MODEL=<loaded-model-name>

# LMStudio temperature for the review LLM call (0.0-1.0)
OPENAI_TEMPERATURE=0.01

# Request timeout in seconds (default: 120 = 2 minutes)
OPENAI_TIMEOUT=120
